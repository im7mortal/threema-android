{
  "name": "threema-android",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,
  "mounts": [
    "source=threema-android-gradle,target=/home/vscode/.gradle,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "fwcd.kotlin",
        "rust-lang.rust-analyzer",
        "ms-androidtools.vscode-android"
      ]
    }
  },
  "containerEnv": {
    "ANDROID_SDK_ROOT": "/opt/android-sdk",
    "ANDROID_HOME": "/opt/android-sdk",
    "ANDROID_NDK_ROOT": "/opt/android-sdk/ndk/28.2.13676358"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "printf 'Build APK: ./gradlew assembleStore_googleDebug\\nInstrumented tests: ./gradlew connectedNoneDebugAndroidTest\\n'"
}
